{
  "$description": "Tipografía. Dos familias, como en el waitlist: Barlow Condensed para titulares y Barlow para texto corrido.",
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["Barlow Condensed", "Barlow", "system-ui", "sans-serif"]
      },
      "body": {
        "$type": "fontFamily",
        "$value": ["Barlow", "system-ui", "sans-serif"]
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "$description": "El nombre es el tamaño en px, para que nadie tenga que memorizar a qué equivale una 'md'.",
      "13": { "$type": "dimension", "$value": "13px" },
      "14": { "$type": "dimension", "$value": "14px" },
      "16": { "$type": "dimension", "$value": "16px" },
      "17": { "$type": "dimension", "$value": "17px" },
      "18": { "$type": "dimension", "$value": "18px" },
      "24": { "$type": "dimension", "$value": "24px" },
      "30": { "$type": "dimension", "$value": "30px" },
      "40": { "$type": "dimension", "$value": "40px" },
      "56": { "$type": "dimension", "$value": "56px" }
    },
    "line-height": {
      "display": {
        "$type": "number",
        "$value": 1.088,
        "$description": "El interlineado exacto de los titulares del waitlist. Se conserva tal cual para no mover el diseño ya aprobado."
      },
      "tight": { "$type": "number", "$value": 1.2 },
      "snug": { "$type": "number", "$value": 1.3 },
      "normal": { "$type": "number", "$value": 1.4 },
      "relaxed": { "$type": "number", "$value": 1.45 },
      "loose": { "$type": "number", "$value": 1.6 }
    }
  }
}
