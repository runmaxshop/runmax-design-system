{
  "$description": "Colores de RunMax. Formato DTCG (w3c design tokens). Los primitivos son la paleta cruda; nadie los usa directamente en un componente — se usan los semánticos, que son los que dan significado y los que se podrían re-mapear para un tema oscuro sin tocar un solo componente.",
  "color": {
    "lime": {
      "$description": "Verde de marca. El 500 es el verde oficial (#AAFF00, confirmado por el equipo el 2026-08-15) y el 600 es el hover que ya vivía en 22 archivos de la app.",
      "50": { "$type": "color", "$value": "#F5FFDB" },
      "100": { "$type": "color", "$value": "#EBFFB8" },
      "200": { "$type": "color", "$value": "#DDFF8A" },
      "300": { "$type": "color", "$value": "#CCFF52" },
      "400": { "$type": "color", "$value": "#BBFF29" },
      "500": { "$type": "color", "$value": "#AAFF00" },
      "600": { "$type": "color", "$value": "#88CC00" },
      "700": { "$type": "color", "$value": "#669900" },
      "800": { "$type": "color", "$value": "#4D7300" },
      "900": { "$type": "color", "$value": "#334D00" },
      "mist": {
        "$type": "color",
        "$value": "#D7EFAB",
        "$description": "Verde pálido desaturado del fondo de la sección de registro. No está en la rampa principal porque no es una luminancia del mismo tono; se conserva porque producción depende de él."
      }
    },
    "neutral": {
      "$description": "Grises. Varios de estos valores llevan una comprobación de contraste detrás — ver contrast.config.json y `npm run check:contrast`.",
      "0": { "$type": "color", "$value": "#FFFFFF" },
      "50": { "$type": "color", "$value": "#F2F2EE" },
      "100": { "$type": "color", "$value": "#E8E8E2" },
      "200": { "$type": "color", "$value": "#DEDEDE" },
      "300": { "$type": "color", "$value": "#A8A69C" },
      "400": { "$type": "color", "$value": "#757575" },
      "500": { "$type": "color", "$value": "#6E6C64" },
      "600": { "$type": "color", "$value": "#5C5A54" },
      "700": { "$type": "color", "$value": "#4A4841" },
      "800": { "$type": "color", "$value": "#252324" },
      "900": { "$type": "color", "$value": "#151515" },
      "950": { "$type": "color", "$value": "#000000" }
    },
    "danger": {
      "500": { "$type": "color", "$value": "#C0392B" },
      "50": { "$type": "color", "$value": "#FEF2F2" }
    },
    "success": {
      "500": { "$type": "color", "$value": "#15803D" },
      "50": { "$type": "color", "$value": "#F0FDF4" }
    },
    "warning": {
      "500": { "$type": "color", "$value": "#B45309" },
      "50": { "$type": "color", "$value": "#FFFBEB" }
    }
  },

  "text": {
    "$description": "Color de texto por rol. Nunca uses un primitivo para texto: usa uno de estos.",
    "default": { "$type": "color", "$value": "{color.neutral.950}" },
    "strong": { "$type": "color", "$value": "{color.neutral.800}" },
    "deep": { "$type": "color", "$value": "{color.neutral.900}" },
    "muted": { "$type": "color", "$value": "{color.neutral.600}" },
    "subtle": { "$type": "color", "$value": "{color.neutral.700}" },
    "placeholder": { "$type": "color", "$value": "{color.neutral.500}" },
    "on-inverse": { "$type": "color", "$value": "{color.neutral.0}" },
    "on-brand": {
      "$type": "color",
      "$value": "{color.neutral.800}",
      "$description": "Sobre el verde de marca el texto va oscuro. Blanco sobre #AAFF00 da 1.4:1 y es ilegible."
    },
    "danger": { "$type": "color", "$value": "{color.danger.500}" },
    "link": { "$type": "color", "$value": "{color.neutral.900}" }
  },

  "surface": {
    "default": { "$type": "color", "$value": "{color.neutral.0}" },
    "subtle": { "$type": "color", "$value": "{color.neutral.50}" },
    "field": { "$type": "color", "$value": "{color.neutral.50}" },
    "field-hover": { "$type": "color", "$value": "{color.neutral.100}" },
    "inverse": { "$type": "color", "$value": "{color.neutral.800}" },
    "inverse-hover": { "$type": "color", "$value": "#3A3739" },
    "brand": { "$type": "color", "$value": "{color.lime.500}" },
    "brand-hover": { "$type": "color", "$value": "{color.lime.600}" },
    "brand-subtle": { "$type": "color", "$value": "{color.lime.mist}" },
    "danger-subtle": { "$type": "color", "$value": "{color.danger.50}" }
  },

  "border": {
    "default": { "$type": "color", "$value": "{color.neutral.200}" },
    "strong": { "$type": "color", "$value": "{color.neutral.800}" },
    "focus": { "$type": "color", "$value": "{color.neutral.800}" },
    "danger": { "$type": "color", "$value": "{color.danger.500}" }
  }
}
