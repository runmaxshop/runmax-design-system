{
  "$description": "Espaciado, radios, alturas de control, bordes y movimiento. Igual que en las tipografías, el nombre del token ES su valor en px: `space.16` son 16px. Se prefiere eso a una escala t-shirt porque elimina la traducción mental y hace evidente cuándo alguien está inventando un valor nuevo.",

  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "2": { "$type": "dimension", "$value": "2px" },
    "4": { "$type": "dimension", "$value": "4px" },
    "8": { "$type": "dimension", "$value": "8px" },
    "10": { "$type": "dimension", "$value": "10px" },
    "12": { "$type": "dimension", "$value": "12px" },
    "14": { "$type": "dimension", "$value": "14px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "18": { "$type": "dimension", "$value": "18px" },
    "22": { "$type": "dimension", "$value": "22px" },
    "26": { "$type": "dimension", "$value": "26px" },
    "32": { "$type": "dimension", "$value": "32px" },
    "40": { "$type": "dimension", "$value": "40px" },
    "48": { "$type": "dimension", "$value": "48px" },
    "64": { "$type": "dimension", "$value": "64px" },
    "80": { "$type": "dimension", "$value": "80px" }
  },

  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "El radio de inputs y del toggle en el waitlist."
    },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "pill": { "$type": "dimension", "$value": "999px" },
    "circle": { "$type": "dimension", "$value": "50%" }
  },

  "control": {
    "$description": "Alturas de los elementos interactivos. El mínimo es 44px, que es el área táctil mínima recomendada por WCAG 2.1 (2.5.5 Target Size).",
    "height": {
      "sm": { "$type": "dimension", "$value": "44px" },
      "md": { "$type": "dimension", "$value": "52px" },
      "lg": {
        "$type": "dimension",
        "$value": "56px",
        "$description": "Normaliza los 56px del botón de bloque y los 57px del botón del hero. La diferencia de 1px no era intencional."
      }
    }
  },

  "border-width": {
    "thin": { "$type": "dimension", "$value": "1px" },
    "focus": { "$type": "dimension", "$value": "2px" }
  },

  "focus": {
    "$description": "El anillo de foco es un token, no una decisión por componente: si cada uno lo dibuja a su manera, la navegación por teclado se vuelve impredecible.",
    "width": { "$type": "dimension", "$value": "2px" },
    "offset": { "$type": "dimension", "$value": "2px" },
    "offset-lg": { "$type": "dimension", "$value": "3px" }
  },

  "duration": {
    "instant": { "$type": "duration", "$value": "0ms" },
    "fast": { "$type": "duration", "$value": "120ms" },
    "base": { "$type": "duration", "$value": "180ms" },
    "slow": { "$type": "duration", "$value": "320ms" }
  },

  "easing": {
    "standard": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] },
    "out": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] }
  },

  "elevation": {
    "none": { "$type": "shadow", "$value": "none" },
    "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(21, 21, 21, 0.06)" },
    "md": { "$type": "shadow", "$value": "0 4px 16px rgba(21, 21, 21, 0.08)" },
    "lg": { "$type": "shadow", "$value": "0 12px 40px rgba(21, 21, 21, 0.12)" }
  },

  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "480px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1024px" },
    "xl": { "$type": "dimension", "$value": "1280px" }
  }
}
